# Database Configuration
# Copy this file to .env and fill in your Neon Postgres connection string

# Neon Postgres connection string
# Format: postgresql+asyncpg://user:password@host/database
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Environment
ENVIRONMENT=development
